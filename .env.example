# =============================================================================
# Plantilla de Configuración de Entorno - MediaWiki Sync
# =============================================================================
# Uso Local: Copia este archivo como '.env' en la raíz del proyecto y edita sus valores.
# Uso en Producción / CI/CD / Docker: Define las variables directamente en el sistema
# (vía 'export MW_...', variables de entorno de contenedor Docker, Kubernetes o CI/CD).
#
# Jerarquía de resolución de configuración (Precedencia):
#   1. Parámetros explícitos pasados por CLI (--url, --wiki-user, etc.)
#   2. Variables de entorno del Sistema Operativo / Contenedor / CI/CD
#   3. Archivo '.env' local (si existe en el directorio de trabajo)
#   4. Valores por defecto definidos internamente en el código
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Endpoint y Servidor MediaWiki
# -----------------------------------------------------------------------------
# URL completa del endpoint Action API de tu servidor MediaWiki
MW_URL=https://wiki.example.com/api.php

# -----------------------------------------------------------------------------
# 2. Autenticación Perimetral / Web / Proxy (HTTP Basic Auth) - Capa 1
# -----------------------------------------------------------------------------
# Requerido si el servidor está protegido tras Apache, Nginx o Proxy Inverso
MW_HTTP_USER=tu_usuario_apache_aqui
MW_HTTP_PASS=tu_contraseña_apache_aqui

# -----------------------------------------------------------------------------
# 3. Autenticación de Usuario MediaWiki (Action API) - Capa 2
# -----------------------------------------------------------------------------
# Requerido para iniciar sesión en la wiki y publicar/subir cambios
MW_WIKI_USER=tu_usuario_de_wiki_aqui
MW_WIKI_PASS=tu_contraseña_de_wiki_aqui

# -----------------------------------------------------------------------------
# 4. Compatibilidad Legada (Respaldo / Fallback)
# -----------------------------------------------------------------------------
# Si no se definen MW_HTTP_USER o MW_WIKI_USER, se usan como respaldo genérico
# MW_USER=usuario_generico
# MW_PASS=contraseña_generica

# -----------------------------------------------------------------------------
# 5. Red, Seguridad y Certificados TLS/SSL
# -----------------------------------------------------------------------------
# Activar verificación estricta de certificados SSL (true/false/1/0/yes/no)
MW_VERIFY_SSL=false

# Ruta a archivo CA Bundle (.crt o .pem) para validar SSL corporativo o autofirmado
MW_CA_BUNDLE=

# Tiempo límite de espera (timeout) en segundos para peticiones HTTP/HTTPS (por defecto: 10.0)
MW_TIMEOUT=10.0

# User-Agent personalizado para peticiones HTTP
MW_USER_AGENT=MediaWikiSync/3.0 (Python; BiDirectional)

# -----------------------------------------------------------------------------
# 6. Rendimiento y Rutas Locales
# -----------------------------------------------------------------------------
# Directorio local de documentación (acepta rutas relativas como ./wiki_docs o absolutas como /var/docs/wiki).
# NOTA: No es necesario ejecutar 'mw-sync' desde dentro de esta carpeta; la herramienta detecta la ruta
# automáticamente desde esta variable (o el parámetro --dir) y gestionará allí los archivos Markdown,
# imágenes y el archivo de estado .sync_state.json de forma transparente desde cualquier ubicación.
# - Si se especifica una ruta relativa (ej. ./wiki_docs), se resolverá de forma relativa a este archivo .env.
# - Si se especifica el punto '.' (MW_OUTPUT_DIR=.), se usará directamente la raíz del proyecto sin subcarpetas.
# - Si se omite en el archivo .env, por defecto se asume la subcarpeta './wiki_docs' del proyecto.
MW_OUTPUT_DIR=./wiki_docs

# Número de hilos concurrentes para la descarga paralela de páginas e imágenes
MW_THREADS=8

# Idioma de la interfaz y mensajes en consola (es = español, en = inglés / default: es)
MW_LANG=es

# Resumen por defecto que aparecerá en el historial de revisiones de MediaWiki al publicar
MW_EDIT_SUMMARY=Actualizado desde local Markdown vía mediawiki_sync

# -----------------------------------------------------------------------------
# 7. Variables de Entorno para Pruebas / Testing E2E (Opcional)
# -----------------------------------------------------------------------------
# Activa la ejecución de pruebas E2E contra un servidor MediaWiki en vivo (1=activo, 0=inactivo)
# MW_TEST_LIVE=0
# MW_TEST_LIVE_URL=http://localhost:8080/api.php
# MW_TEST_WIKI_USER=TestAdmin
# MW_TEST_WIKI_PASS=TestPass123

