# =============================================================================
# Configuración de Conexión MediaWiki
# Copia este archivo como .env y edita tus credenciales
# =============================================================================
MW_URL=https://wiki.example.com/api.php

# Capa 1: Autenticación Web / Proxy / Apache (HTTP Basic Auth)
MW_HTTP_USER=tu_usuario_apache_aqui
MW_HTTP_PASS=tu_contraseña_apache_aqui

# Capa 2: Cuenta de usuario de MediaWiki (Action API)
MW_WIKI_USER=tu_usuario_de_wiki_aqui
MW_WIKI_PASS=tu_contraseña_de_wiki_aqui

# Opciones adicionales
MW_VERIFY_SSL=false
MW_OUTPUT_DIR=./wiki_docs
MW_THREADS=8
MW_USER_AGENT=MediaWikiSync/3.0 (Python; BiDirectional)
MW_EDIT_SUMMARY=Actualizado desde local Markdown vía mediawiki_sync

